        </mxCell>
        <mxCell id="note3" value="A retro modifier DENY, from ANY resource, resets that code's whole consent history built up so far — stronger than a plain .6 deny. A retro modifier PERMIT never does this." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="10" y="860" width="780" height="16" as="geometry" />
        </mxCell>

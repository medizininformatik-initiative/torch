        </mxCell>
        <mxCell id="note2" value="A .6 deny now reduces the retro-extended period regardless of which resource it comes from (Case 3) — it is no longer permanently immune." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">

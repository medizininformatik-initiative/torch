        <mxCell id="note1" value="Retro extension itself is unchanged: a retro modifier PERMIT only extends .6 when it overlaps .6 in the SAME Consent resource (Cases 1 &amp; 2)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">

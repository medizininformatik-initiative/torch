            "linkedGroups": ["orga-group"]
          }
        ]
      },
      {
        "id": "orga-group",
        "name": "Organization",
        "includeReferenceOnly": true,
        "groupReference": "https://www.medizininformatik-initiative.de/fhir/ext/modul-biobank/StructureDefinition/Organization",
        "attributes": [
